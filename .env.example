# Required. "client:secret[:limitPerMin]", comma separated. Generate secrets with: openssl rand -hex 32
API_KEYS=eix-web:replace-with-long-random-secret
PORT=8080
RATE_LIMIT_PER_MIN=60
# Browser origins allowed to call the API directly (leave empty for server-to-server use)
CORS_ORIGINS=
# Prime after the SARB's 23 Jul 2026 hold. Update with RATE_AS_OF in src/schema.ts after each MPC meeting.
DEFAULT_RATE=10.5
# Optional: listing hosts the URL source may fetch
ALLOWED_HOSTS=
# Optional: fills fields a listing page states but the parser missed
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5
LOG=on
# Neighbourhood layer: use a self-hosted or paid Overpass endpoint in production
OVERPASS_URL=
OSM_USER_AGENT=eix-property-decision-api/1.0 (contact: you@example.com)
# Optional: your licensed sales and rentals feed (see README for the contract)
COMPS_PROVIDER_URL=
COMPS_PROVIDER_KEY=
# Optional: JSON file overriding any scoring weights or thresholds
SCORING_CONFIG=
